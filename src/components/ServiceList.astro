---
import { services, type ServiceId } from '@/data/services';
import { serviceHref, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  exclude?: ServiceId;
}
const { lang, exclude } = Astro.props;
const list = services.filter((s) => s.id !== exclude);
---

<ul class="border-t border-line">
  {
    list.map((s) => (
      <li class="reveal border-b border-line">
        <a
          href={serviceHref(lang, s[lang].slug)}
          class="group relative grid items-center gap-x-8 gap-y-3 py-8 sm:py-10 md:grid-cols-12"
        >
          <span
            aria-hidden="true"
            class="absolute inset-0 -z-10 origin-bottom scale-y-0 rounded-2xl bg-surface transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:scale-y-100"
          />
          <span class="font-mono text-xs text-muted md:col-span-1 md:pl-4">{s.number}</span>
          <h3 class="font-display text-3xl font-semibold tracking-tight transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-2 sm:text-5xl md:col-span-5">
            {s[lang].name}
          </h3>
          <p class="leading-relaxed text-muted md:col-span-5">{s[lang].short}</p>
          <span
            aria-hidden="true"
            class="hidden size-12 place-items-center justify-self-end rounded-full border border-line transition-all duration-500 group-hover:-rotate-45 group-hover:border-transparent group-hover:bg-accent group-hover:text-accent-ink md:col-span-1 md:mr-4 md:grid"
          >
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>
