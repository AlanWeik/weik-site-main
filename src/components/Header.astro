---
import { routes, t, contactHref, type Lang, type Alternates } from '@/i18n';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const i = t(lang);
const path = Astro.url.pathname;
const other: Lang = lang === 'sv' ? 'en' : 'sv';

const links = [
  { href: routes.services[lang], label: i.nav.services },
  { href: routes.projects[lang], label: i.nav.projects },
  { href: routes.about[lang], label: i.nav.about },
  { href: routes.contact[lang], label: i.nav.contact },
];
const isActive = (href: string) => path.startsWith(href);
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="container-x pt-3 sm:pt-4">
    <div
      class="flex h-14 items-center justify-between gap-4 rounded-full border border-line bg-bg/70 pl-5 pr-2 backdrop-blur-xl backdrop-saturate-150 sm:h-16 sm:pl-6"
    >
      <a href={routes.home[lang]} aria-label="Weik – start" class="text-[1.65rem] sm:text-[1.9rem]">
        <Logo />
      </a>

      <nav aria-label={lang === 'sv' ? 'Huvudmeny' : 'Main navigation'} class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={isActive(l.href) ? 'page' : undefined}
                  class:list={[
                    'rounded-full px-4 py-2 text-[0.95rem] transition-colors hover:bg-surface-2',
                    isActive(l.href) ? 'text-fg bg-surface-2' : 'text-muted hover:text-fg',
                  ]}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={alternates[other]}
          hreflang={other}
          lang={other}
          aria-label={i.langSwitchLabel}
          class="hidden h-10 items-center rounded-full border border-line px-3 font-mono text-xs uppercase tracking-wider hover:border-fg sm:inline-flex"
        >
          {other}
        </a>
        <ThemeToggle label={i.themeToggle} />
        <a href={contactHref(lang)} class="btn btn-primary hidden !min-h-11 sm:inline-flex">
          {i.ctaShort}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <button
          type="button"
          popovertarget="mobile-menu"
          class="grid size-10 place-items-center rounded-full border border-line lg:hidden"
          aria-label={i.menu}
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M4 8h16M4 16h16" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<div id="mobile-menu" popover class="mobile-menu m-0 h-dvh max-h-none w-full max-w-none bg-bg text-fg p-0">
  <div class="container-x flex h-full flex-col pb-10 pt-3 sm:pt-4">
    {/* Same chrome as the fixed header so the X lands exactly on the burger. */}
    <div
      class="flex h-14 items-center justify-between gap-4 rounded-full border border-line bg-bg pl-5 pr-2 sm:h-16 sm:pl-6"
    >
      <Logo class="text-[1.65rem] sm:text-[1.9rem]" />
      <div class="flex items-center gap-2">
        <ThemeToggle label={i.themeToggle} />
        <button
          type="button"
          popovertarget="mobile-menu"
          popovertargetaction="hide"
          class="grid size-10 place-items-center rounded-full border border-line"
          aria-label={i.close}
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>
    <nav aria-label={i.menu} class="mt-auto">
      <ul class="space-y-1">
        {
          links.map((l, idx) => (
            <li>
              <a href={l.href} class="flex items-baseline gap-4 py-2 font-display text-5xl font-semibold tracking-tight">
                <span class="font-mono text-xs text-muted">0{idx + 1}</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a href={contactHref(lang)} class="btn btn-primary flex-1">
        {i.ctaPrimary}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a href={alternates[other]} hreflang={other} class="btn btn-ghost">{i.langSwitch}</a>
    </div>
  </div>
</div>

<style>
  /* No display/overlay transitions — those hang for seconds on iOS Safari when closing. */
  .mobile-menu {
    inset: 0;
    opacity: 0;
    transform: translateY(-0.75rem);
  }
  .mobile-menu:popover-open {
    opacity: 1;
    transform: none;
    transition:
      opacity 280ms ease,
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
  }
</style>

<script>
  const menu = document.getElementById('mobile-menu');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
</script>
