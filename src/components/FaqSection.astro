---
import type { Faq } from '@/data/services';
import { faqPage } from '@/lib/schema';

interface Props {
  faq: Faq[];
  title: string;
  eyebrow?: string;
  intro?: string;
}
const { faq, title, eyebrow = 'FAQ', intro } = Astro.props;
---

<section class="container-x py-24 sm:py-32" aria-labelledby="faq-title">
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow reveal">{eyebrow}</p>
      <h2 id="faq-title" class="h-section mt-5 reveal">{title}</h2>
      {intro && <p class="mt-6 text-lg leading-relaxed text-muted reveal">{intro}</p>}
    </div>
    <div class="lg:col-span-8 border-t border-line">
      {
        faq.map((f, idx) => (
          <details class="faq group border-b border-line" name="faq" open={idx === 0}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-left">
              <h3 class="font-display text-xl font-medium tracking-tight sm:text-2xl">{f.q}</h3>
              <span
                class="mt-1 grid size-8 shrink-0 place-items-center rounded-full border border-line transition-transform duration-300 group-open:rotate-45 group-open:bg-accent group-open:text-accent-ink group-open:border-transparent"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="faq-body">
              <p class="max-w-2xl pb-7 text-[1.05rem] leading-relaxed text-muted">{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqPage(faq))} />
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  @supports (interpolate-size: allow-keywords) {
    .faq {
      interpolate-size: allow-keywords;
    }
    .faq::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 450ms cubic-bezier(0.16, 1, 0.3, 1),
        content-visibility 450ms allow-discrete;
    }
    .faq[open]::details-content {
      block-size: auto;
    }
  }
</style>
