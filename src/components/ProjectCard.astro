---
import { Image } from 'astro:assets';
import type { Project } from '@/data/projects';
import { projectHref, type Lang } from '@/i18n';

interface Props {
  project: Project;
  lang: Lang;
  size?: 'lg' | 'md';
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { project: p, lang, size = 'md', headingLevel: H = 'h3', eager = false } = Astro.props;
const copy = p[lang];
---

<article class="reveal group relative">
  <a href={projectHref(lang, p.slug)} class="block">
    <div
      class:list={[
        'relative overflow-hidden rounded-3xl border border-line bg-surface-2',
        size === 'lg' ? 'aspect-[4/3] lg:aspect-[16/11]' : 'aspect-[4/3]',
      ]}
    >
      <Image
        src={p.image}
        alt={`${p.name} – ${copy.category}`}
        widths={[480, 800, 1200]}
        sizes={size === 'lg' ? '(min-width: 1024px) 58vw, 100vw' : '(min-width: 1024px) 40vw, 100vw'}
        loading={eager ? 'eager' : 'lazy'}
        class="size-full object-cover object-top transition-transform duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
      />
      <span class="absolute left-4 top-4 rounded-full bg-bg/85 px-3 py-1.5 font-mono text-[0.7rem] uppercase tracking-wider backdrop-blur">
        {copy.category}
      </span>
      <span
        aria-hidden="true"
        class="absolute bottom-4 right-4 grid size-12 translate-y-2 place-items-center rounded-full bg-accent text-accent-ink opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100"
      >
        ↗
      </span>
    </div>
    <div class="mt-5 flex items-start justify-between gap-6">
      <div>
        <H class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">{p.name}</H>
        <p class="mt-2 max-w-md leading-relaxed text-muted">{copy.summary}</p>
      </div>
    </div>
  </a>
</article>
