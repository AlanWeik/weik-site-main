---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import CtaBlock from '@/components/CtaBlock.astro';
import { site } from '@/config/site';
import { skills, why } from '@/data/content';
import { routes, t, type Lang } from '@/i18n';
import portrait from '@/assets/people/alan-dark.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const i = t(lang);
const copy = {
  sv: {
    title: 'Om Weik – webbstudio & fullstackutvecklare i Halmstad | Alan Weik',
    description:
      'Weik är en webbstudio i Halmstad grundad av fullstackutvecklaren Alan Weik. Vi hjälper företag i Halland och hela Sverige med hemsidor, e-handel och SEO.',
    eyebrow: 'Om Weik',
    h1: 'En webbstudio i Halmstad som bygger för affären, inte för portfolion.',
    lead: 'Weik grundades med en enkel idé: en hemsida ska vara ett av företagets bästa verktyg för att vinna kunder. Därför börjar vi alltid med dina mål och bygger tekniken runt dem.',
    storyTitle: 'Från utbildning till studio',
    story: [
      'Bakom Weik står jag, Alan Weik – utbildad .NET-fullstackutvecklare från YC Utbildning och med över tre års erfarenhet av webbutveckling. Jag har byggt allt från internationella webbshoppar och företagssajter till AI-drivna webbappar.',
      'Jag är känd för att vara anpassningsbar, nyfiken och proaktiv – egenskaper som gör att projekt håller tidsplanen även när det går fort i agila team. Kombinationen av smart design, tydlig kommunikation och ett resultatfokuserat arbetssätt är det som gör skillnad för mina kunder.',
      'I dag driver jag Weik från Halmstad och arbetar med företag i hela Halland och resten av Sverige. Vid behov tar jag in specialister inom design, foto och copy, så att du alltid får rätt kompetens – men med en kontaktperson.',
    ],
    facts: [
      { k: '3+ år', v: 'erfarenhet av fullstackutveckling' },
      { k: '.NET', v: 'fullstackutbildning, YC Utbildning' },
      { k: 'Halmstad', v: 'bas för uppdrag i hela Halland' },
    ],
    stackTitle: 'Verktyg och tekniker',
    valuesTitle: 'Det här kan du räkna med',
    cv: 'Ladda ner CV',
    linkedin: 'LinkedIn',
  },
  en: {
    title: 'About Weik – web studio & full-stack developer in Halmstad, Sweden',
    description:
      'Weik is a web studio in Halmstad, Sweden, founded by full-stack developer Alan Weik. We help businesses with websites, e-commerce and SEO.',
    eyebrow: 'About Weik',
    h1: 'A web studio in Halmstad that builds for your business, not for awards.',
    lead: 'Weik was founded on a simple idea: a website should be one of a company’s best tools for winning customers. That is why we always start with your goals and build the technology around them.',
    storyTitle: 'From education to studio',
    story: [
      'Behind Weik is me, Alan Weik – a trained .NET full-stack developer (YC Utbildning) with over three years of web development experience. I have built everything from international online stores and corporate websites to AI-powered web apps.',
      'I am known for being adaptable, curious and proactive – qualities that keep projects on schedule even in fast-moving agile teams. The combination of smart design, clear communication and a results-driven approach is what makes the difference for my clients.',
      'Today I run Weik from Halmstad and work with businesses across Sweden and beyond. When needed, I bring in specialists in design, photography and copy, so you always get the right expertise – with a single point of contact.',
    ],
    facts: [
      { k: '3+ yrs', v: 'full-stack development experience' },
      { k: '.NET', v: 'full-stack education, YC Utbildning' },
      { k: 'Halmstad', v: 'home base on the Swedish west coast' },
    ],
    stackTitle: 'Tools and technologies',
    valuesTitle: 'What you can count on',
    cv: 'Download CV',
    linkedin: 'LinkedIn',
  },
}[lang];
const crumbs = [
  { name: i.breadcrumbHome, href: routes.home[lang] },
  { name: i.nav.about, href: routes.about[lang] },
];
---

<Base lang={lang} title={copy.title} description={copy.description} alternates={routes.about}>
  <section class="container-x pb-16 pt-36 sm:pt-44">
    <Breadcrumbs items={crumbs} />
    <div class="hero-enter mt-10">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="mt-6 max-w-6xl font-display text-[clamp(2.5rem,6.5vw,6rem)] font-semibold leading-[0.95]">{copy.h1}</h1>
      <p class="mt-10 max-w-2xl text-xl leading-relaxed text-muted">{copy.lead}</p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="reveal-scale sticky top-28 overflow-hidden rounded-3xl bg-black">
          <Image
            src={portrait}
            alt={lang === 'sv' ? 'Porträtt av Alan Weik, grundare av Weik' : 'Portrait of Alan Weik, founder of Weik'}
            widths={[400, 700, 900]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            loading="eager"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <h2 class="h-section reveal">{copy.storyTitle}</h2>
        <div class="prose-weik mt-8 text-lg leading-relaxed text-muted">
          {copy.story.map((p) => <p class="reveal">{p}</p>)}
        </div>
        <dl class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-3">
          {
            copy.facts.map((f) => (
              <div class="reveal bg-bg p-6">
                <dt class="font-display text-3xl font-semibold tracking-tight">{f.k}</dt>
                <dd class="mt-2 text-sm leading-snug text-muted">{f.v}</dd>
              </div>
            ))
          }
        </dl>
        <div class="reveal mt-10 flex flex-wrap gap-3">
          <a href={site.cv} target="_blank" rel="noopener" class="btn btn-ghost">{copy.cv} <span aria-hidden="true">↓</span></a>
          <a href={site.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">{copy.linkedin} <span aria-hidden="true">↗</span></a>
        </div>

        <h2 class="reveal mt-20 font-display text-3xl font-semibold">{copy.stackTitle}</h2>
        <ul class="reveal mt-6 flex flex-wrap gap-2">
          {skills.map((s) => <li class="rounded-full border border-line px-4 py-2 text-[0.95rem]">{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="container-x py-24 sm:py-32">
    <h2 class="h-section reveal max-w-3xl">{copy.valuesTitle}</h2>
    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        why[lang].map((w) => (
          <div class="reveal rounded-3xl border border-line p-7">
            <span class="block size-2.5 rounded-full bg-accent ring-1 ring-line" aria-hidden="true" />
            <h3 class="mt-8 font-display text-2xl font-semibold">{w.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{w.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <ProcessSection lang={lang} />
  <CtaBlock lang={lang} />
</Base>
